# ──────────────────────────────────────────────
# MCP Gateway – Environment Variables
# ──────────────────────────────────────────────

# Gateway HTTP port (default: 3000)
GATEWAY_PORT=3000

# Optional Bearer token to protect the gateway endpoint.
# Leave empty to disable authentication.
GATEWAY_AUTH_TOKEN=

# ──────────────────────────────────────────────
# GitHub Copilot Server
# ──────────────────────────────────────────────

# Path to the directory containing custom Copilot agents, skills, and instructions.
# In Docker this is mounted automatically from ./copilot-assets.
COPILOT_ASSETS_DIR=./copilot-assets

# ──────────────────────────────────────────────
# Antigravity Server
# ──────────────────────────────────────────────

# Path to Antigravity's local data directory.
# Default on macOS: ~/.gemini/antigravity
ANTIGRAVITY_DATA_DIR=~/.gemini/antigravity

# ──────────────────────────────────────────────
# Cursor Server
# ──────────────────────────────────────────────

# Path to Cursor's global configuration directory.
# Default on macOS: ~/.cursor
CURSOR_CONFIG_DIR=~/.cursor

# Path to the workspace directory to manage.
CURSOR_WORKSPACE_DIR=.

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────

# Log level: debug | info | warn | error
LOG_LEVEL=info
